---
import { evaluation as e, contactHref, bookingNote } from '../site.config';
interface Props { sport?: string }
const { sport } = Astro.props;
const href = e.buyUrl || contactHref(`$1 speed evaluation`);
---
<section class="eval" id="evaluation">
  <div class="wrap eval__in">
    <div>
      <span class="eyebrow">New athletes start here</span>
      <h2>{sport ? `${sport} speed evaluation` : 'Speed evaluation'} for <span class="eval__price">{e.price}</span></h2>
      <p class="muted">Find out where you stand before you commit. A coach tests you, shows you the numbers, and tells you exactly what to train.</p>
      <a href={href} class="btn btn--primary" data-package="evaluation">{e.buyUrl ? `Book your ${e.price} evaluation` : `Email to book your ${e.price} evaluation`}</a>
      {!e.buyUrl && <p class="muted small" style="margin-top:12px">{bookingNote}</p>}
    </div>
    <ul class="check-list eval__list">
      {e.includes.map((i) => <li>{i}</li>)}
    </ul>
  </div>
</section>

<style>
  .eval { padding: 56px 0; background: linear-gradient(135deg, var(--forest), var(--black) 70%); border-top: 1px solid var(--green-deep); border-bottom: 1px solid var(--green-deep); }
  .eval__in { display: grid; grid-template-columns: 1.3fr 1fr; gap: 40px; align-items: center; }
  .eval h2 { margin-bottom: 12px; }
  .eval__price { color: var(--green-bright); }
  .eval .muted { margin-bottom: 24px; max-width: 560px; }
  .eval__list { margin: 0; }
  @media (max-width: 820px) { .eval__in { grid-template-columns: 1fr; gap: 24px; } }
</style>
