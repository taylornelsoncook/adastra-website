---
import { faqs } from '../site.config';
interface Props { limit?: number }
const { limit } = Astro.props;
const items = limit ? faqs.slice(0, limit) : faqs;
---
<div class="faq">
  {items.map((f) => (
    <details>
      <summary>{f.q}</summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>

<style>
  .faq { max-width: 820px; margin: 0 auto; border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary {
    cursor: pointer; list-style: none; padding: 22px 40px 22px 0; position: relative;
    font: 600 1.1rem/1.4 var(--sans); color: var(--steel);
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: '+'; position: absolute; right: 6px; top: 50%; transform: translateY(-50%);
    font-size: 1.5rem; color: var(--green-bright); font-weight: 400;
  }
  details[open] summary::after { content: '−'; }
  details p { color: var(--steel-muted); padding-bottom: 22px; margin: 0; }
</style>
