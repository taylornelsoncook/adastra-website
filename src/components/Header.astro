---
const nav = [
  { href: '/schedule/', label: 'Schedule' },
  { href: '/packages/', label: 'Packages' },
  { href: '/college/', label: 'College' },
  { href: '/coaches/', label: 'Coaches' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/start/', label: 'Contact' },
];
const path = Astro.url.pathname;
---
<header class="hdr">
  <div class="wrap hdr__in">
    <a href="/" class="hdr__logo" aria-label="Ad Astra Human Performance, home">
      <img src="/brand/lockup-horizontal.webp" alt="Ad Astra Human Performance" width="163" height="60" />
    </a>
    <nav aria-label="Main">
      <input type="checkbox" id="nav-toggle" class="hdr__toggle" />
      <label for="nav-toggle" class="hdr__burger" aria-label="Menu"><span></span></label>
      <ul class="hdr__nav">
        {nav.map((n) => (
          <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
        <li><a href="/packages/" class="btn btn--primary hdr__cta">Buy a package</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: sticky; top: 0; z-index: 50;
    background: rgba(7, 9, 8, 0.86);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; min-height: 76px; }
  .hdr__logo img { height: 60px; width: auto; }
  .hdr__nav { list-style: none; display: flex; align-items: center; gap: 28px; margin: 0; padding: 0; }
  .hdr__nav a:not(.btn) { color: var(--steel-muted); text-decoration: none; font-weight: 500; }
  .hdr__nav a:not(.btn):hover, .hdr__nav a[aria-current='page'] { color: var(--steel); }
  .hdr__cta { min-height: 42px; padding: 10px 18px; }
  .hdr__toggle, .hdr__burger { display: none; }

  @media (max-width: 820px) {
    .hdr__logo img { height: 48px; }
    .hdr__burger {
      display: flex; width: 44px; height: 44px; align-items: center; justify-content: center; cursor: pointer;
    }
    .hdr__burger span, .hdr__burger span::before, .hdr__burger span::after {
      display: block; width: 22px; height: 2px; background: var(--steel); position: relative; content: '';
    }
    .hdr__burger span::before { position: absolute; top: -7px; }
    .hdr__burger span::after { position: absolute; top: 7px; }
    .hdr__nav {
      display: none; position: absolute; left: 0; right: 0; top: 100%;
      flex-direction: column; align-items: stretch; gap: 0;
      background: var(--black); border-bottom: 1px solid var(--line); padding: 8px 20px 20px;
    }
    .hdr__nav li a:not(.btn) { display: block; padding: 14px 0; border-bottom: 1px solid var(--line); }
    .hdr__cta { margin-top: 16px; width: 100%; }
    .hdr__toggle:checked ~ .hdr__nav { display: flex; }
  }
</style>
