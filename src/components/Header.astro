---
import { sports } from '../sports';
type NavItem = { href: string; label: string; match?: string; children?: { href: string; label: string }[] };
const nav: NavItem[] = [
  { href: '/schedule/', label: 'Schedule' },
  { href: '/packages/', label: 'Packages' },
  { href: '/sports/', label: 'Sports', children: sports.map((s) => ({ href: `/sports/${s.slug}/`, label: s.name })) },
  { href: '/college/', label: 'College' },
  { href: '/teams/', label: 'Teams' },
  { href: '/adults/personal-training/', label: 'Adults', match: '/adults/', children: [
    { href: '/adults/personal-training/', label: 'Personal Training' },
    { href: '/adults/personal-training/#waitlist', label: 'Adult Program Waitlist' },
  ] },
  { href: '/coaches/', label: 'Coaches' },
  { href: '/start/', label: 'Contact' },
];
const path = Astro.url.pathname;
---
<header class="hdr">
  <div class="wrap hdr__in">
    <a href="/" class="hdr__logo" aria-label="Ad Astra Human Performance, home">
      <img src="/brand/lockup-horizontal.webp" alt="Ad Astra Human Performance" width="163" height="60" />
    </a>
    <nav aria-label="Main">
      <input type="checkbox" id="nav-toggle" class="hdr__toggle" />
      <label for="nav-toggle" class="hdr__burger" aria-label="Menu"><span></span></label>
      <ul class="hdr__nav">
        {nav.map((n) => n.children ? (
          <li class="hdr__drop">
            <a href={n.href} aria-current={path.startsWith(n.match ?? n.href) ? 'page' : undefined} aria-haspopup="true">{n.label}<span class="hdr__caret" aria-hidden="true"></span></a>
            <ul class={`hdr__sub${n.children.length < 4 ? ' hdr__sub--short' : ''}`}>
              {n.children.map((c) => (
                <li><a href={c.href} aria-current={!c.href.includes('#') && path === c.href ? 'page' : undefined}>{c.label}</a></li>
              ))}
            </ul>
          </li>
        ) : (
          <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
        <li><a href="/packages/" class="btn btn--primary hdr__cta">Buy a package</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: sticky; top: 0; z-index: 50;
    background: rgba(7, 9, 8, 0.86);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; min-height: 76px; }
  .hdr__logo img { height: 60px; width: auto; }
  .hdr__nav { list-style: none; display: flex; align-items: center; gap: 22px; margin: 0; padding: 0; }
  .hdr__nav a:not(.btn) { color: var(--steel-muted); text-decoration: none; font-weight: 500; }
  .hdr__nav a:not(.btn):hover, .hdr__nav a[aria-current='page'] { color: var(--steel); }
  .hdr__cta { min-height: 42px; padding: 10px 18px; }
  .hdr__toggle, .hdr__burger { display: none; }
  .hdr__drop { position: relative; }
  .hdr__caret { display: inline-block; width: 6px; height: 6px; margin-left: 7px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: translateY(-3px) rotate(45deg); }
  .hdr__sub {
    list-style: none; margin: 0; padding: 8px 0; position: absolute; top: 100%; left: -16px; min-width: 200px;
    background: var(--black); border: 1px solid var(--line); border-radius: var(--radius-sm);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
    opacity: 0; visibility: hidden; transform: translateY(6px); transition: opacity .15s, transform .15s, visibility .15s;
  }
  .hdr__drop::after { content: ''; position: absolute; left: 0; right: 0; top: 100%; height: 12px; }
  .hdr__sub { margin-top: 12px; }
  .hdr__drop:hover .hdr__sub, .hdr__drop:focus-within .hdr__sub { opacity: 1; visibility: visible; transform: none; }
  .hdr__sub a:not(.btn) { display: block; padding: 9px 16px; white-space: nowrap; }
  .hdr__sub a:not(.btn):hover { background: var(--surface); }

  @media (max-width: 1120px) {
    .hdr__logo img { height: 48px; }
    .hdr__burger {
      display: flex; width: 44px; height: 44px; align-items: center; justify-content: center; cursor: pointer;
    }
    .hdr__burger span, .hdr__burger span::before, .hdr__burger span::after {
      display: block; width: 22px; height: 2px; background: var(--steel); position: relative; content: '';
    }
    .hdr__burger span::before { position: absolute; top: -7px; }
    .hdr__burger span::after { position: absolute; top: 7px; }
    .hdr__nav {
      display: none; position: absolute; left: 0; right: 0; top: 100%;
      flex-direction: column; align-items: stretch; gap: 0;
      background: var(--black); border-bottom: 1px solid var(--line); padding: 8px 20px 20px;
      max-height: calc(100vh - 76px); overflow-y: auto;
    }
    .hdr__nav li a:not(.btn) { display: block; padding: 14px 0; border-bottom: 1px solid var(--line); }
    .hdr__cta { margin-top: 16px; width: 100%; }
    .hdr__caret, .hdr__drop::after { display: none; }
    .hdr__sub {
      position: static; opacity: 1; visibility: visible; transform: none; margin: 0; padding: 0 0 0 16px;
      border: 0; box-shadow: none; background: none; min-width: 0;
      display: grid; grid-template-columns: 1fr 1fr; column-gap: 16px;
    }
    .hdr__sub a:not(.btn) { padding: 11px 0; font-size: .95rem; }
    .hdr__sub a:not(.btn):hover { background: none; }
    .hdr__sub--short { grid-template-columns: 1fr; }
    .hdr__toggle:checked ~ .hdr__nav { display: flex; }
  }
</style>
