---
import { packages, schedule, site } from '../site.config';
// A package with no checkout link yet sends buyers to a coach instead of a dead end.
const buyLink = (p: (typeof packages)[number]) => p.buyUrl || site.links.leadForm;
---
<div class="grid grid--3 pk">
  {packages.map((p) => (
    <article class:list={['card', 'pk__card', { 'pk__card--featured': p.featured }]} id={p.id}>
      {p.badge && <span class="pk__badge">{p.badge}</span>}
      <span class="pk__where">{p.where === 'facility' ? `At ${schedule.facility}` : 'Train anywhere'}</span>
      <h3>{p.name}</h3>
      <p class="pk__price">{p.price}<span>/mo</span></p>
      <p class="pk__per">{p.per}{p.rate && <> · {p.rate}</>}</p>
      <p class="muted">{p.blurb}</p>
      <ul class="check-list">
        {p.features.map((f) => <li>{f}</li>)}
      </ul>
      <a
        class:list={['btn', p.featured ? 'btn--primary' : 'btn--ghost', 'pk__buy']}
        href={buyLink(p)}
        rel="noopener"
        data-package={p.id}
      >
        {p.buyUrl ? `Buy ${p.name}: ${p.price}` : `Ask to join: ${p.price}`}
      </a>
      {p.buyNote && <p class="pk__note">{p.buyNote}</p>}
    </article>
  ))}
</div>

<style>
  .pk { align-items: stretch; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); max-width: 820px; margin: 0 auto; }
  .pk__card { position: relative; display: flex; flex-direction: column; }
  .pk__card--featured { border-color: var(--green-deep); box-shadow: 0 0 0 1px var(--green-deep), 0 20px 60px -30px rgba(63, 196, 108, 0.45); }
  .pk__badge {
    position: absolute; top: -12px; right: 20px;
    background: var(--green); color: #04140a; font-size: .75rem; font-weight: 600;
    padding: 4px 10px; border-radius: 999px; letter-spacing: .04em;
  }
  .pk__where { font-size: .75rem; letter-spacing: .24em; text-transform: uppercase; color: var(--green-bright); margin-bottom: 10px; }
  .pk__price { font: 700 2.6rem/1 var(--display); margin: 4px 0 8px; }
  .pk__price span { font-size: 1rem; color: var(--steel-muted); font-weight: 600; margin-left: 4px; }
  .pk__per { font-size: .85rem; letter-spacing: .12em; text-transform: uppercase; color: var(--steel-muted); margin-bottom: 14px; }
  .pk__card .check-list { flex: 1; }
  .pk__buy { width: 100%; }
  .pk__note { margin: 10px 0 0; font-size: .85rem; color: var(--steel-muted); text-align: center; }
</style>
