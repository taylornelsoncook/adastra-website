---
import { schedule } from '../site.config';
const dayNames: Record<string, string> = { M: 'Monday', T: 'Tuesday', W: 'Wednesday', TH: 'Thursday', F: 'Friday' };
const spell = (d: string) => d.split('/').map((x) => dayNames[x] ?? x).join(', ');
---
<div class="sch">
  <table>
    <caption class="sr">Weekly class schedule at {schedule.facility}</caption>
    <thead><tr><th scope="col">Days</th><th scope="col">Class</th><th scope="col">Time</th></tr></thead>
    <tbody>
      {schedule.classes.map((c) => (
        <tr>
          <td class="sch__days"><abbr title={spell(c.days)}>{c.days}</abbr></td>
          <td class="sch__name">{c.name}</td>
          <td class="sch__time">{c.time}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="sch__note">Every class is <strong>{schedule.minutes} minutes</strong>, not 60.</p>
</div>

<style>
  .sch { max-width: 820px; margin: 0 auto; }
  table {
    width: 100%; border-collapse: collapse;
    background: var(--surface); border: 1px solid var(--line); border-left: 4px solid var(--green);
    border-radius: var(--radius-md); overflow: hidden;
  }
  thead th {
    text-align: left; font: 600 .72rem/1 var(--sans); letter-spacing: .24em; text-transform: uppercase;
    color: var(--steel-dim); padding: 18px 22px 12px;
  }
  thead th:last-child, .sch__time { text-align: right; }
  td { padding: 16px 22px; border-top: 1px solid var(--line); vertical-align: middle; }
  .sch__days abbr { text-decoration: none; letter-spacing: .16em; color: var(--green-bright); font-weight: 600; font-size: .9rem; }
  .sch__name { font: 700 1.15rem/1.3 var(--display); }
  .sch__time { font: 700 1.15rem/1.3 var(--display); color: var(--green-bright); white-space: nowrap; }
  .sch__note { margin-top: 20px; font: 600 1.25rem/1.4 var(--display); text-align: center; }
  .sch__note strong { color: var(--green-bright); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  @media (max-width: 560px) {
    thead { display: none; }
    tr { display: grid; grid-template-columns: 1fr auto; grid-template-areas: 'name time' 'days days'; border-top: 1px solid var(--line); padding: 14px 16px; }
    tbody tr:first-child { border-top: 0; }
    td { border: 0; padding: 0; }
    .sch__name { grid-area: name; font-size: 1.05rem; }
    .sch__time { grid-area: time; font-size: 1.05rem; padding-left: 12px; }
    .sch__days { grid-area: days; padding-top: 4px; }
  }
</style>
