---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="section section--glow" style="min-height:60vh">
    <div class="wrap center">
      <span class="eyebrow">404</span>
      <h1 class="metal">Off course.</h1>
      <p class="lead">That page does not exist. Let's get you back on track.</p>
      <div class="btn-row"><a href="/" class="btn btn--primary">Home</a><a href="/packages/" class="btn btn--ghost">Packages</a></div>
    </div>
  </section>
</Base>
