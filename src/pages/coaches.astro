---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import ProofStrip from '../components/ProofStrip.astro';
import Carousel from '../components/Carousel.astro';
import { gallery } from '../gallery';
import { headCoach as c, proAthletes, developmentAthletes, programs, career, certifications } from '../coaches';
import { site } from '../site.config';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: c.name,
  jobTitle: c.title,
  worksFor: { '@type': 'Organization', name: site.name, url: site.url },
  hasCredential: certifications.map((x) => ({ '@type': 'EducationalOccupationalCredential', name: x.name })),
  sameAs: [c.instagram],
};
---
<Base
  title="Coaches"
  description={`Meet ${c.name}, ${c.creds}: ${c.years} years coaching athletes from youth to the NFL and MLB, including 200+ NFL Combine and Pro Day athletes.`}
  schema={[person]}
>
  <section class="section section--glow">
    <div class="wrap coach">
      <div class="coach__photo">
        {c.photo
          ? <img src={c.photo} alt={c.name} width="480" height="600" />
          : <div class="coach__ph"><img src="/brand/mark.webp" alt="" width="140" height="193" /></div>}
      </div>
      <div>
        <span class="eyebrow">Coaches</span>
        <h1 class="metal">{c.name}</h1>
        <p class="coach__title">{c.title} · {c.creds}</p>
        <p class="lead">{c.summary}</p>
        <div class="btn-row">
          <a href="/packages/" class="btn btn--primary">Train with Taylor</a>
          <a href={c.instagram} class="btn btn--ghost" rel="noopener">Instagram</a>
        </div>
      </div>
    </div>
  </section>

  {gallery.length > 0 && (
    <section class="section" id="photos">
      <div class="wrap">
        <Carousel photos={gallery} label="Ad Astra training photos" />
      </div>
    </section>
  )}

  <ProofStrip showNames={false} />

  <section class="section">
    <div class="wrap narrow">
      <h2>Coaching background</h2>
      {c.bio.map((p) => <p class="muted big">{p}</p>)}
    </div>
  </section>

  <section class="section section--glow" id="athletes">
    <div class="wrap">
      <div class="center" style="margin-bottom:40px">
        <span class="eyebrow">Athletes trained</span>
        <h2>From youth to the pros.</h2>
        <p class="lead">Athletes Taylor has trained and programmed for across a 12-year career.</p>
      </div>
      <div class="grid grid--2">
        <div class="card">
          <h3>NFL</h3>
          <ul class="names">{proAthletes.nfl.map((n) => <li>{n}</li>)}</ul>
        </div>
        <div class="card">
          <h3>MLB</h3>
          <ul class="names">{proAthletes.mlb.map((n) => <li>{n}</li>)}</ul>
        </div>
      </div>
      <div class="card" style="margin-top:20px">
        <h3>Other professional, college and high school athletes</h3>
        <ul class="names names--wide">{developmentAthletes.map((n) => <li>{n}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="center" style="margin-bottom:40px">
        <span class="eyebrow">Teams and programs</span>
        <h2>Programs Taylor has built for.</h2>
      </div>
      <ul class="teams">
        {programs.map((p) => (
          <li>{p.name}{p.note && <span class="teams__note">{p.note}</span>}</li>
        ))}
      </ul>
    </div>
  </section>

  <hr class="divider" />

  <section class="section">
    <div class="wrap narrow">
      <span class="eyebrow">Experience</span>
      <h2>Career</h2>
      <ol class="career">
        {career.map((r) => (
          <li>
            <div class="career__head">
              <h3>{r.title}</h3>
              <span class="career__dates">{r.dates}</span>
            </div>
            <p class="career__org">{r.org}</p>
            <ul class="check-list">{r.points.map((p) => <li>{p}</li>)}</ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--tight" style="background:var(--ground);border-top:1px solid var(--line)">
    <div class="wrap">
      <div class="center" style="margin-bottom:32px"><span class="eyebrow">Certifications</span></div>
      <ul class="certs">
        {certifications.map((x) => <li><strong>{x.short}</strong><span>{x.name}</span></li>)}
      </ul>
    </div>
  </section>

  <CtaBand title="Train with a coach who has done it at every level." />
</Base>

<style>
  .coach { display: grid; grid-template-columns: minmax(220px, 380px) 1fr; gap: 56px; align-items: center; }
  .coach__photo img { width: 100%; height: auto; border-radius: var(--radius-md); border: 1px solid var(--line); }
  .coach__ph {
    aspect-ratio: 4 / 5; border-radius: var(--radius-md); border: 1px solid var(--line);
    background: radial-gradient(circle at 50% 40%, var(--forest), var(--black) 75%);
    display: flex; align-items: center; justify-content: center;
  }
  .coach__ph img { width: 120px; border: 0; }
  .coach__title { color: var(--green-bright); font-weight: 600; letter-spacing: .04em; margin-bottom: 20px; }
  .coach .lead { margin-bottom: 28px; }
  .narrow { max-width: 820px; }
  .big { font-size: 1.08rem; }
  .names { list-style: none; padding: 0; margin: 0; columns: 2; column-gap: 24px; }
  .names--wide { columns: 4; }
  .names li { padding: 7px 0; border-bottom: 1px solid var(--line); break-inside: avoid; font-weight: 500; }
  .teams { list-style: none; padding: 0; margin: 0 auto; max-width: 980px; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .teams li {
    border: 1px solid var(--line); background: var(--surface); border-radius: var(--radius-sm);
    padding: 12px 18px; font-weight: 600;
  }
  .teams__note { margin-left: 10px; color: var(--green-bright); font-size: .8rem; letter-spacing: .1em; text-transform: uppercase; }
  .career { list-style: none; padding: 0; margin: 32px 0 0; }
  .career > li { border-left: 2px solid var(--green-deep); padding: 0 0 32px 24px; position: relative; }
  .career > li::before {
    content: ''; position: absolute; left: -7px; top: 6px; width: 12px; height: 12px; border-radius: 50%;
    background: var(--black); border: 2px solid var(--green-bright);
  }
  .career__head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; align-items: baseline; }
  .career__head h3 { margin: 0; }
  .career__dates { color: var(--steel-dim); font-size: .9rem; }
  .career__org { color: var(--green-bright); font-weight: 600; margin: 4px 0 14px; }
  .certs { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; }
  .certs li { display: flex; gap: 14px; align-items: center; padding: 14px 16px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface); }
  .certs strong { font-family: var(--display); color: var(--green-bright); min-width: 64px; }
  .certs span { color: var(--steel-muted); font-size: .92rem; }
  @media (max-width: 820px) {
    .coach { grid-template-columns: 1fr; gap: 32px; }
    .coach__photo { max-width: 300px; }
    .names--wide { columns: 2; }
  }
  @media (max-width: 420px) { .names { columns: 1; } .names--wide { columns: 2; } }
</style>
