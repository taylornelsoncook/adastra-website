---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import ProofStrip from '../components/ProofStrip.astro';
import { college, schedule, site } from '../site.config';

const sessions = schedule.classes.filter((c) => /college/i.test(c.name));
const focus = [
  { t: 'Show up to camp ready', d: 'Off-season and break training that has you arriving faster, stronger and in shape, so you earn reps on day one.' },
  { t: 'Speed and power that transfer', d: 'Acceleration, top speed, change of direction and power work tested and progressed every block.' },
  { t: 'Strength without wear and tear', d: 'Lifting built from your tested maxes, with training load that respects what your body has been through in season.' },
  { t: 'Bulletproof the body', d: 'Mobility, tissue work and injury-reduction training so you stay on the field.' },
];
const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'College athlete performance training',
  provider: { '@type': 'Organization', name: site.name, url: site.url },
  areaServed: site.location.serviceArea,
  description: 'Coached speed, strength and power training for college athletes and college commits in Englewood, CO.',
  ...(college.price ? { offers: { '@type': 'Offer', price: college.price.replace(/[^0-9.]/g, ''), priceCurrency: 'USD' } } : {}),
};
---
<Base
  title="College Athlete Training"
  description="Speed, strength and power training for college athletes and college commits in Englewood, CO. Coached 80-minute sessions from a coach who has prepared 200+ NFL Combine athletes."
  schema={[service]}
>
  <section class="section section--glow">
    <div class="wrap college">
      <div>
        <span class="eyebrow">College athletes &amp; commits</span>
        <h1 class="metal">Train for the next level.</h1>
        <p class="lead">
          Home for break, between seasons, or getting ready to report? Train with the coach who has prepared 200+ athletes for the NFL
          Combine and Pro Days, in coached 80-minute sessions.
        </p>
        <div class="btn-row">
          <a href={college.buyUrl} class="btn btn--primary" rel="noopener" data-package="college">
            Buy college training{college.price && `: ${college.price}`}
          </a>
          <a href={site.links.leadForm} class="btn btn--ghost" rel="noopener">Ask a coach</a>
        </div>
        {college.per && <p class="muted per">{college.per}</p>}
      </div>
      <div class="card sessions">
        <span class="eyebrow">College Commits sessions</span>
        <ul>
          {sessions.map((c) => (
            <li><span class="d">{c.days}</span><span class="t">{c.time}</span></li>
          ))}
        </ul>
        <p class="muted small">Every session is {schedule.minutes} minutes, not 60. <a href="/schedule/">Full schedule</a></p>
      </div>
    </div>
  </section>

  <ProofStrip />

  <section class="section">
    <div class="wrap">
      <div class="center" style="margin-bottom:40px">
        <span class="eyebrow">What we train</span>
        <h2>Built for college athletes.</h2>
      </div>
      <div class="grid focus">
        {focus.map((f) => <div class="card"><h3>{f.t}</h3><p class="muted">{f.d}</p></div>)}
      </div>
      <div class="center" style="margin-top:40px">
        <a href={college.buyUrl} class="btn btn--primary" rel="noopener" data-package="college">Buy college training</a>
      </div>
    </div>
  </section>

  <CtaBand title="Earn your spot before camp." text="Buy college training and start this week, or ask a coach how it fits around your team's schedule." />
</Base>

<style>
  .college { display: grid; grid-template-columns: 1.4fr 1fr; gap: 48px; align-items: center; }
  .college .lead { margin-bottom: 28px; }
  .per { margin-top: 14px; }
  .sessions ul { list-style: none; padding: 0; margin: 0 0 16px; }
  .sessions li { display: flex; justify-content: space-between; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .sessions .d { letter-spacing: .16em; color: var(--green-bright); font-weight: 600; }
  .sessions .t { font: 700 1.2rem/1 var(--display); }
  .small { font-size: .9rem; }
  .focus { grid-template-columns: repeat(2, 1fr); max-width: 980px; margin: 0 auto; }
  @media (max-width: 700px) { .focus { grid-template-columns: 1fr; } }
  @media (max-width: 820px) { .college { grid-template-columns: 1fr; } }
</style>
