---
import Base from '../layouts/Base.astro';
import PackageCards from '../components/PackageCards.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import ScheduleTable from '../components/ScheduleTable.astro';
import { site, schedule } from '../site.config';

const pillars = [
  { t: 'Speed', d: 'Acceleration, top-end speed and change of direction, coached and timed so you can see the gains.' },
  { t: 'Strength & power', d: 'Lifting built for athletes: weights from your tested maxes, progressions you earn, power that carries to the field.' },
  { t: 'Durability', d: 'Mobility, recovery and smart training load around your games, so you are fresh and healthy when it counts.' },
];
const steps = [
  { n: '01', t: 'Find your group', d: 'College Commits, High School Performance, Youth and HS Lacrosse, or your Kings team.' },
  { n: '02', t: 'Pick a package', d: '8 sessions a month for $300, or 12 sessions for $400. Month to month.' },
  { n: '03', t: 'Train', d: 'Show up to your class at Factum. Every session is 80 coached minutes, not 60.' },
];
---
<Base>
  <section class="hero section--glow">
    <div class="wrap hero__in">
      <div class="hero__copy">
        <span class="eyebrow">Athlete performance training</span>
        <h1 class="metal">Built for athletes who want more.</h1>
        <p class="lead">
          Coached 80-minute speed, strength and performance classes at {schedule.facility}, for youth, high school, lacrosse and
          college-commit athletes. 8 or 12 sessions a month.
        </p>
        <div class="btn-row">
          <a href="/packages/" class="btn btn--primary">Buy a package</a>
          <a href="/schedule/" class="btn btn--ghost">See the schedule</a>
        </div>
      </div>
      <div class="hero__art" aria-hidden="true">
        <img src="/brand/mark.webp" alt="" width="360" height="497" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="center">
        <span class="eyebrow">What we train</span>
        <h2>Every part of the athlete.</h2>
      </div>
      <div class="grid grid--3" style="margin-top:40px">
        {pillars.map((p) => (
          <div class="card">
            <h3>{p.t}</h3>
            <p class="muted">{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section">
    <div class="wrap">
      <div class="center">
        <span class="eyebrow">How it works</span>
        <h2>Three steps to your first session.</h2>
      </div>
      <ol class="steps grid grid--3">
        {steps.map((s) => (
          <li>
            <span class="steps__n">{s.n}</span>
            <h3>{s.t}</h3>
            <p class="muted">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--glow" id="schedule">
    <div class="wrap">
      <div class="center" style="margin-bottom:40px">
        <span class="eyebrow">Starting {schedule.startsOn}</span>
        <h2>New schedule <span class="at">@ {schedule.facility}</span></h2>
      </div>
      <ScheduleTable />
    </div>
  </section>

  <section class="section" id="packages">
    <div class="wrap">
      <div class="center" style="margin-bottom:48px">
        <span class="eyebrow">Monthly packages</span>
        <h2>Choose how you train.</h2>
        <p class="lead">Month to month. Use your sessions in any class on your group's schedule.</p>
      </div>
      <PackageCards />
    </div>
  </section>

  <hr class="divider" />

  <section class="section">
    <div class="wrap">
      <div class="center" style="margin-bottom:32px">
        <span class="eyebrow">Questions</span>
        <h2>Common questions.</h2>
      </div>
      <FaqList limit={4} />
      <p class="center" style="margin-top:28px"><a href="/faq/">See all questions</a></p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero { padding: 72px 0 96px; overflow: hidden; }
  .hero__in { display: grid; grid-template-columns: 1.3fr 1fr; gap: 40px; align-items: center; }
  .hero__art { display: flex; justify-content: center; }
  .hero__art img { width: min(320px, 70%); height: auto; filter: drop-shadow(0 0 60px rgba(63, 196, 108, 0.18)); }
  .hero .lead { margin-bottom: 28px; }
  .at { color: var(--green-bright); }
  .steps { list-style: none; padding: 0; margin: 40px 0 0; }
  .steps li { border-top: 2px solid var(--green-deep); padding-top: 22px; }
  .steps__n { font: 700 0.9rem/1 var(--display); color: var(--green-bright); letter-spacing: .1em; display: block; margin-bottom: 12px; }
  @media (max-width: 820px) {
    .hero { padding: 40px 0 64px; }
    .hero__in { grid-template-columns: 1fr; }
    .hero__art { order: -1; }
    .hero__art img { width: 140px; }
  }
</style>
