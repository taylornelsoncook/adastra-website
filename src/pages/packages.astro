---
import Base from '../layouts/Base.astro';
import PackageCards from '../components/PackageCards.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { packages, site } from '../site.config';

const offers = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Ad Astra monthly training packages',
  itemListElement: packages.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: `${p.name} (${p.per})`,
      description: p.blurb,
      provider: { '@type': 'Organization', name: site.name },
      offers: { '@type': 'Offer', price: p.price.replace(/[^0-9.]/g, ''), priceCurrency: 'USD' },
    },
  })),
};
---
<Base title="Monthly Training Packages" description="Ad Astra monthly packages at Factum: 8 sessions for $300 or 12 sessions for $400. Every class is 80 coached minutes." schema={[offers]}>
  <section class="section section--glow">
    <div class="wrap">
      <div class="center" style="margin-bottom:56px">
        <span class="eyebrow">Monthly packages</span>
        <h1 class="metal">Choose how you train.</h1>
        <p class="lead">
          Coached 80-minute classes at Factum, month to month. Pick how many sessions you want each month and use them in your
          group's classes on the <a href="/schedule/">schedule</a>.
        </p>
      </div>
      <PackageCards />
      <p class="center muted note">
        Checkout is through Mindbody. Training away from Factum? <a href={site.links.leadForm} rel="noopener">Ask a coach</a> about
        remote programming.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="center" style="margin-bottom:32px"><h2>Before you buy.</h2></div>
      <FaqList />
    </div>
  </section>

  <CtaBand title="Not sure where to start?" text="Tell us about your athlete and a coach will recommend the right package." />
</Base>

<style>
  .note { margin-top: 32px; font-size: .95rem; }
</style>
