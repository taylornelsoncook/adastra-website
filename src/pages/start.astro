---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
---
<Base title="Contact" description="Ask a coach about Ad Astra training. Tell us about your athlete and we will recommend the right package and a free evaluation.">
  <section class="section section--glow">
    <div class="wrap center">
      <span class="eyebrow">Talk to a coach</span>
      <h1 class="metal">Ask about training.</h1>
      <p class="lead">
        Tell us about your athlete, their sport and their goals. A coach will get back to you with the right package and a free
        evaluation time.
      </p>
      <div class="btn-row">
        <a href={site.links.leadForm} class="btn btn--primary" rel="noopener">Ask about training</a>
        <a href="/packages/" class="btn btn--ghost">See packages</a>
      </div>
      <p class="muted contact">
        Train with us at {site.location.venue}:
        <a href={site.location.mapsUrl} rel="noopener">{site.location.street}, {site.location.city}, {site.location.region} {site.location.postalCode}</a>.
        <br />
        Or email <a href={`mailto:${site.email}`}>{site.email}</a>{site.phone && <> or call <a href={`tel:${site.phone}`}>{site.phone}</a></>}.
      </p>
    </div>
  </section>
</Base>

<style>
  .contact { margin-top: 32px; }
  .section { min-height: 60vh; display: flex; align-items: center; }
</style>
