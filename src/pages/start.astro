---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { contactForm, contactHref, forms, site } from '../site.config';
const href = contactHref();
const ext = href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {};
---
<Base title="Contact" description="Contact Ad Astra Human Performance in Englewood, CO. Tell us about your athlete and a coach will recommend the right package and group.">
  <section class="section section--glow">
    <div class="wrap center">
      <span class="eyebrow">Talk to a coach</span>
      <h1 class="metal">Contact us.</h1>
      <p class="lead">
        Tell us about your athlete, their sport and their goals. A coach will get back to you with the right package and
        group for them.
      </p>
      {contactForm.accessKey ? (
        <div class="form-wrap"><ContactForm /></div>
      ) : (
        <div class="btn-row">
          <a href={href} class="btn btn--primary" {...ext}>{forms.contact ? 'Fill out the contact form' : 'Contact us'}</a>
          <a href="/packages/" class="btn btn--ghost">See packages</a>
        </div>
      )}
      <p class="muted contact">
        Prefer email? <a href={`mailto:${site.email}`}>{site.email}</a>{site.phone && <> or call <a href={`tel:${site.phone}`}>{site.phone}</a></>}.
      </p>
    </div>
  </section>
</Base>

<style>
  .contact { margin-top: 32px; }
  .form-wrap { margin-top: 36px; }
  .section { min-height: 60vh; display: flex; align-items: center; }
</style>
