---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import ProofStrip from '../components/ProofStrip.astro';
import { teamTraining as t, site } from '../site.config';
import { programs } from '../coaches';

const href = t.buyUrl || site.links.leadForm;
const loc = `${site.location.city}, ${site.location.region}`;
const pillars = [
  { t: 'Cohesiveness', d: 'Athletes who sweat together play together. Shared training builds trust, communication and a team that moves as one.' },
  { t: 'Camaraderie', d: 'Hard sessions, shared goals and team challenges build the kind of bond that shows up in the fourth quarter.' },
  { t: 'A standard everyone meets', d: 'One program, one coaching standard, the same expectations for every athlete on the roster.' },
  { t: 'Performance that shows', d: 'Speed, strength and power tested as a team, so coaches see who is improving and where to push.' },
];
const included = [
  'Coached 80-minute team sessions',
  'Team testing: sprints, jumps and strength',
  'Programming planned around your season and game schedule',
  'Speed, strength, power and injury-reduction training',
  'Progress reports for coaches',
  `${t.price || 'Discounted pricing'} for teams of ${t.minAthletes} or more athletes`,
];
const faqs = [
  { q: 'How many athletes do we need for team pricing?', a: `Team pricing starts at ${t.minAthletes} athletes${t.price ? `: ${t.price}` : ''}. Smaller groups can join our regular classes.` },
  { q: 'Can you train our team in season?', a: 'Yes. In season, training is lighter around games so athletes stay fresh, then builds back up between games.' },
  { q: 'What sports do you train?', a: 'Football, lacrosse, soccer, baseball, basketball, hockey, swim, golf, and track and field teams, from youth through college.' },
  { q: 'How do we get started?', a: 'Tell us about your team, roster size and season. A coach will follow up with a plan, schedule options and team pricing.' },
];
const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Team performance training',
  provider: { '@type': 'Organization', name: site.name, url: site.url },
  areaServed: site.location.serviceArea,
  description: `Team speed, strength and conditioning training in ${loc}, with discounted pricing for teams of ${t.minAthletes}+ athletes.`,
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base
  title={`Team Training in ${loc}`}
  description={`Team speed and strength training that builds cohesiveness and camaraderie. Discounted pricing for teams of ${t.minAthletes}+ athletes in ${loc}.`}
  schema={[service, faqSchema]}
>
  <section class="section section--glow">
    <div class="wrap teamhero">
      <div>
        <span class="eyebrow">Team training</span>
        <h1 class="metal">Stronger together.</h1>
        <p class="lead">
          Team performance training that builds faster, stronger athletes and a closer team. Coached sessions, one shared standard,
          and a discounted rate for teams of {t.minAthletes} or more.
        </p>
        <div class="btn-row">
          <a href={href} class="btn btn--primary" rel="noopener" data-package="team">{t.price ? 'Sign up your team' : 'Get team pricing'}</a>
          <a href="#included" class="btn btn--ghost">What's included</a>
        </div>
      </div>
      <div class="card offer">
        <span class="eyebrow">Team rate</span>
        <p class="offer__big">{t.minAthletes}+</p>
        <p class="offer__lbl">athletes</p>
        <p class="offer__price">{t.price || 'Discounted per-athlete pricing'}</p>
        {t.price && <p class="muted offer__save">Save 40% vs. the $300 individual rate</p>}
        <a href={href} class="btn btn--primary" rel="noopener" data-package="team">{t.price ? 'Sign up your team' : 'Ask for team pricing'}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="center" style="margin-bottom:40px">
        <span class="eyebrow">Why train as a team</span>
        <h2>Built for the whole roster.</h2>
      </div>
      <div class="grid twocol">
        {pillars.map((p) => <div class="card"><h3>{p.t}</h3><p class="muted">{p.d}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section section--glow" id="included">
    <div class="wrap narrow">
      <span class="eyebrow">What's included</span>
      <h2>Everything your team needs.</h2>
      <ul class="check-list big">{included.map((i) => <li>{i}</li>)}</ul>
      <a href={href} class="btn btn--primary" rel="noopener" data-package="team">{t.price ? 'Sign up your team' : 'Get team pricing'}</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="center" style="margin-bottom:32px">
        <span class="eyebrow">Teams and programs</span>
        <h2>Programs our head coach has built for.</h2>
      </div>
      <ul class="teams">
        {programs.map((p) => <li>{p.name}{p.note && <span class="teams__note">{p.note}</span>}</li>)}
      </ul>
    </div>
  </section>

  <ProofStrip />

  <section class="section">
    <div class="wrap narrow">
      <h2>Team training questions</h2>
      <div class="faq">
        {faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </div>
  </section>

  <CtaBand title="Build a team that trains like one." text={`Tell us about your roster. Teams of ${t.minAthletes}+ get discounted pricing.`} />
</Base>

<style>
  .teamhero { display: grid; grid-template-columns: 1.4fr 1fr; gap: 48px; align-items: center; }
  .teamhero .lead { margin-bottom: 28px; }
  .offer { text-align: center; border-color: var(--green-deep); }
  .offer__big { font: 700 4.5rem/1 var(--display); color: var(--green-bright); margin: 8px 0 0; }
  .offer__lbl { letter-spacing: .24em; text-transform: uppercase; color: var(--steel-muted); font-size: .85rem; }
  .offer__price { font: 600 1.15rem/1.4 var(--display); margin: 12px 0 20px; }
  .offer .btn { width: 100%; }
  .offer__save { font-size: .9rem; margin: -12px 0 20px; }
  .twocol { grid-template-columns: repeat(2, 1fr); max-width: 980px; margin: 0 auto; }
  .narrow { max-width: 820px; }
  .big li { font-size: 1.08rem; margin-bottom: 14px; }
  .teams { list-style: none; padding: 0; margin: 0 auto; max-width: 980px; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .teams li { border: 1px solid var(--line); background: var(--surface); border-radius: var(--radius-sm); padding: 12px 18px; font-weight: 600; }
  .teams__note { margin-left: 10px; color: var(--green-bright); font-size: .8rem; letter-spacing: .1em; text-transform: uppercase; }
  .faq { border-top: 1px solid var(--line); margin-top: 20px; }
  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; padding: 18px 0; font-weight: 600; }
  details p { color: var(--steel-muted); padding-bottom: 18px; margin: 0; }
  @media (max-width: 820px) { .teamhero, .twocol { grid-template-columns: 1fr; } }
</style>
